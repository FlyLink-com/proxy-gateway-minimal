{
  "name": "proxy-gateway-minimal",
  "version": "0.1.0",
  "description": "Local proxy gateway module and Clash subscription console",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./agent/channel-profile": "./agent/channel-profile.mjs",
    "./agent/edge-tunnel": "./agent/edge-tunnel.mjs",
    "./agent/local-edge-agent": "./agent/local-edge-agent.mjs",
    "./agent/production-edge-agent": "./agent/production-edge-agent.mjs",
    "./agent/socks5-adapter": "./agent/socks5-adapter.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "gccgw": "./bin/gccgw.mjs",
    "proxy-gateway": "./bin/proxy-gateway.mjs"
  },
  "files": [
    "index.mjs",
    "daemon.mjs",
    "candidate-start.mjs",
    "start-server.ps1",
    ".env.example",
    "server/app.mjs",
    "server/index.mjs",
    "server/start.mjs",
    "server/state.mjs",
    "server/middleware",
    "server/routes",
    "server/services",
    "agent",
    "ops",
    "public",
    "config",
    "scripts",
    "bin/gccgw.mjs",
    "bin/proxy-gateway.mjs",
    "docs/API_COMPATIBILITY.md"
  ],
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x || 26.x"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "server": "node server/index.mjs",
    "cli": "node bin/gccgw.mjs",
    "ss": "bin/sslocal.exe -c config/ss-local.json -U",
    "proxy:on": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 on",
    "proxy:off": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 off",
    "proxy:pac": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 pac",
    "proxy:status": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 status",
    "network:status": "node bin/gccgw.mjs ops network-status",
    "network:repair": "powershell -ExecutionPolicy Bypass -File scripts/network-doctor.ps1 repair",
    "network:reset": "powershell -ExecutionPolicy Bypass -File scripts/network-doctor.ps1 reset",
    "channel:dry-run": "node bin/gccgw.mjs channel dry-run",
    "channel:benchmark-run": "node bin/gccgw.mjs channel benchmark-run",
    "channel:benchmark-fixture": "node bin/gccgw.mjs channel benchmark-fixture",
    "channel:benchmark-summary": "node bin/gccgw.mjs channel benchmark-summary",
    "channel:benchmark-score": "node bin/gccgw.mjs channel benchmark-score",
    "channel:candidate-report": "node bin/gccgw.mjs channel candidate-report",
    "channel:candidate-comparison": "node bin/gccgw.mjs channel candidate-comparison",
    "channel:decision-pack": "node bin/gccgw.mjs channel decision-pack",
    "channel:extended-assessment": "node bin/gccgw.mjs channel extended-assessment",
    "channel:extended-report": "node bin/gccgw.mjs channel extended-report",
    "channel:measurement-bundle": "node bin/gccgw.mjs channel measurement-bundle",
    "channel:measurement-investigation": "node bin/gccgw.mjs channel measurement-investigation",
    "channel:runtime-gate-packet": "node bin/gccgw.mjs channel runtime-gate-packet",
    "channel:runtime-evidence-bridge": "node bin/gccgw.mjs channel runtime-evidence-bridge",
    "channel:runtime-inventory-summary": "node bin/gccgw.mjs channel runtime-inventory-summary",
    "channel:runtime-registry": "node bin/gccgw.mjs channel runtime-registry",
    "channel:system-decision-flow": "node bin/gccgw.mjs channel system-decision-flow",
    "channel:subscription-activation-fixture": "node bin/gccgw.mjs channel subscription-activation-fixture",
    "channel:subscription-activation-replay": "node bin/gccgw.mjs channel subscription-activation-replay",
    "channel:subscription-activation-package": "node bin/gccgw.mjs channel subscription-activation-package",
    "channel:production-module": "node bin/gccgw.mjs channel production-module",
    "channel:subscription-activation-record-template": "node bin/gccgw.mjs channel subscription-activation-record-template",
    "channel:subscription-render-proof": "node bin/gccgw.mjs channel subscription-render-proof",
    "platform:controlled-open": "node bin/gccgw.mjs platform controlled-open",
    "platform:provisioning-form": "node bin/gccgw.mjs platform provisioning-form",
    "platform:issue-subscription": "node bin/gccgw.mjs platform issue-subscription",
    "platform:issue-portal-entry": "node bin/gccgw.mjs platform issue-portal-entry",
    "platform:issue-portal-initial-account": "node bin/gccgw.mjs platform issue-portal-initial-account",
    "platform:resource-package": "node bin/gccgw.mjs platform resource-package",
    "platform:revoke-access": "node bin/gccgw.mjs platform revoke-access",
    "platform:access-inventory-summary": "node bin/gccgw.mjs platform access-inventory-summary",
    "platform:clean-edge-readiness-summary": "node bin/gccgw.mjs platform clean-edge-readiness-summary",
    "platform:lead-retention": "node scripts/platform-lead-retention.mjs",
    "docs:authority:check": "node scripts/check-document-authority.mjs",
    "governance:check": "node scripts/check-gate-governance.mjs --snapshot",
    "project-state:check": "node bin/gccgw.mjs project check",
    "project:handoff-brief": "node bin/gccgw.mjs project handoff-brief",
    "project:verify": "node bin/gccgw.mjs project verify",
    "project:verify:admin": "node bin/gccgw.mjs project verify --with-admin",
    "project:architecture": "node bin/gccgw.mjs architecture",
    "project:docs": "node bin/gccgw.mjs docs list",
    "release:config:prepare": "node scripts/control-plane-release-config-gate.mjs --mode prepare",
    "release:config:verify": "node scripts/control-plane-release-config-gate.mjs --mode verify",
    "promotion:health-gate": "node scripts/control-plane-promotion-health-gate.mjs",
    "agent:brief": "node scripts/agent-brief.mjs",
    "precommit:check": "node scripts/precommit-check.mjs",
    "env:check": "node bin/gccgw.mjs env check",
    "self:check": "node bin/gccgw.mjs self check",
    "install:plan": "node bin/gccgw.mjs install plan",
    "install:preflight": "node bin/gccgw.mjs install preflight",
    "service:status": "node bin/gccgw.mjs service status",
    "test": "npm run test:server",
    "test:server": "node --test server/tests/*.test.mjs",
    "test:ci-lanes": "node --test server/tests/ci-change-classifier.test.mjs server/tests/ci-workflow-contract.test.mjs server/tests/artifact-manifest.test.mjs server/tests/cloudflare-deploy-intent.test.mjs server/tests/deploy-receipt.test.mjs",
    "agent:local": "node agent/local-edge-agent.mjs",
    "agent:production:once": "node agent/production-edge-agent.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "daemon": "node daemon.mjs",
    "admin:dev": "npm run dev --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "admin:verify": "npm run verify:admin-build --prefix admin",
    "admin:portal:build": "npm run build:portal --prefix admin",
    "admin:portal:verify": "npm run verify:portal-build --prefix admin",
    "admin:site:build": "npm run build:site --prefix admin",
    "admin:site:verify": "npm run verify:site-build --prefix admin",
    "admin:local-proxy:start": "powershell -ExecutionPolicy Bypass -File ops/local-admin-bridge/start-admin-panel-local-proxy.ps1",
    "admin:local-proxy:stop": "powershell -ExecutionPolicy Bypass -File ops/local-admin-bridge/stop-admin-panel-local-proxy.ps1",
    "cloudflare:site:build": "npm run admin:site:build",
    "cloudflare:site:verify": "npm run admin:site:verify",
    "cloudflare:site:dry-run": "npx --yes wrangler@4.99.0 deploy --config wrangler.jsonc --dry-run",
    "cloudflare:site:validate": "npm run cloudflare:site:build && npm run cloudflare:site:verify && npm run cloudflare:site:dry-run",
    "admin:test": "npm run test --prefix admin"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "8.5.2",
    "node-fetch": "^3.3.2",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.0.0"
  }
}
