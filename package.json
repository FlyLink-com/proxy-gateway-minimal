{
  "name": "proxy-gateway-minimal",
  "version": "0.1.0",
  "description": "Local proxy gateway module and Clash subscription console",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./agent/channel-profile": "./agent/channel-profile.mjs",
    "./agent/edge-tunnel": "./agent/edge-tunnel.mjs",
    "./agent/local-edge-agent": "./agent/local-edge-agent.mjs",
    "./agent/socks5-adapter": "./agent/socks5-adapter.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "proxy-gateway": "./bin/proxy-gateway.mjs"
  },
  "files": [
    "index.mjs",
    "daemon.mjs",
    "start-server.ps1",
    ".env.example",
    "server/app.mjs",
    "server/index.mjs",
    "server/start.mjs",
    "server/state.mjs",
    "server/middleware",
    "server/routes",
    "server/services",
    "agent",
    "public",
    "config",
    "scripts",
    "bin/proxy-gateway.mjs",
    "docs/API_COMPATIBILITY.md"
  ],
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x || 26.x"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "server": "node server/index.mjs",
    "cli": "node bin/proxy-gateway.mjs",
    "ss": "bin/sslocal.exe -c config/ss-local.json -U",
    "proxy:on": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 on",
    "proxy:off": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 off",
    "proxy:pac": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 pac",
    "proxy:status": "powershell -ExecutionPolicy Bypass -File scripts/proxy.ps1 status",
    "network:status": "node bin/proxy-gateway.mjs ops network-status",
    "network:repair": "powershell -ExecutionPolicy Bypass -File scripts/network-doctor.ps1 repair",
    "network:reset": "powershell -ExecutionPolicy Bypass -File scripts/network-doctor.ps1 reset",
    "channel:dry-run": "node bin/proxy-gateway.mjs channel dry-run",
    "channel:benchmark-run": "node bin/proxy-gateway.mjs channel benchmark-run",
    "channel:benchmark-fixture": "node bin/proxy-gateway.mjs channel benchmark-fixture",
    "channel:benchmark-summary": "node bin/proxy-gateway.mjs channel benchmark-summary",
    "channel:benchmark-score": "node bin/proxy-gateway.mjs channel benchmark-score",
    "channel:candidate-report": "node bin/proxy-gateway.mjs channel candidate-report",
    "channel:candidate-comparison": "node bin/proxy-gateway.mjs channel candidate-comparison",
    "channel:decision-pack": "node bin/proxy-gateway.mjs channel decision-pack",
    "channel:extended-assessment": "node bin/proxy-gateway.mjs channel extended-assessment",
    "channel:extended-report": "node bin/proxy-gateway.mjs channel extended-report",
    "channel:measurement-bundle": "node bin/proxy-gateway.mjs channel measurement-bundle",
    "channel:measurement-investigation": "node bin/proxy-gateway.mjs channel measurement-investigation",
    "channel:runtime-gate-packet": "node bin/proxy-gateway.mjs channel runtime-gate-packet",
    "channel:runtime-evidence-bridge": "node bin/proxy-gateway.mjs channel runtime-evidence-bridge",
    "channel:runtime-inventory-summary": "node bin/proxy-gateway.mjs channel runtime-inventory-summary",
    "channel:runtime-registry": "node bin/proxy-gateway.mjs channel runtime-registry",
    "channel:system-decision-flow": "node bin/proxy-gateway.mjs channel system-decision-flow",
    "channel:subscription-activation-fixture": "node bin/proxy-gateway.mjs channel subscription-activation-fixture",
    "channel:subscription-activation-replay": "node bin/proxy-gateway.mjs channel subscription-activation-replay",
    "channel:subscription-activation-package": "node bin/proxy-gateway.mjs channel subscription-activation-package",
    "channel:production-module": "node bin/proxy-gateway.mjs channel production-module",
    "channel:subscription-activation-record-template": "node bin/proxy-gateway.mjs channel subscription-activation-record-template",
    "channel:subscription-render-proof": "node bin/proxy-gateway.mjs channel subscription-render-proof",
    "platform:controlled-open": "node bin/proxy-gateway.mjs platform controlled-open",
    "platform:provisioning-form": "node bin/proxy-gateway.mjs platform provisioning-form",
    "platform:issue-subscription": "node bin/proxy-gateway.mjs platform issue-subscription",
    "platform:issue-portal-entry": "node bin/proxy-gateway.mjs platform issue-portal-entry",
    "platform:resource-package": "node bin/proxy-gateway.mjs platform resource-package",
    "platform:revoke-access": "node bin/proxy-gateway.mjs platform revoke-access",
    "platform:access-inventory-summary": "node bin/proxy-gateway.mjs platform access-inventory-summary",
    "platform:clean-edge-readiness-summary": "node bin/proxy-gateway.mjs platform clean-edge-readiness-summary",
    "project-state:check": "node bin/proxy-gateway.mjs project check",
    "project:verify": "node bin/proxy-gateway.mjs project verify",
    "project:verify:admin": "node bin/proxy-gateway.mjs project verify --with-admin",
    "env:check": "node bin/proxy-gateway.mjs env check",
    "test": "npm run test:server",
    "test:server": "node --test server/tests/*.test.mjs",
    "agent:local": "node agent/local-edge-agent.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "daemon": "node daemon.mjs",
    "admin:dev": "npm run dev --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "admin:site:build": "npm run build:site --prefix admin",
    "admin:site:verify": "npm run verify:site-build --prefix admin",
    "admin:test": "npm run test --prefix admin"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.0.0"
  }
}
