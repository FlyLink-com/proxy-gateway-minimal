{
  "name": "proxy-gateway-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:node-names-preview": "vite --config vite.node-names-preview.config.ts",
    "dev:portal:local-api-validation": "vite --config vite.portal.local-api-validation.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:portal": "tsc --noEmit && vite build --config vite.portal.config.ts",
    "build:portal:web": "tsc --noEmit && vite build --config vite.portal-web.config.ts",
    "build:site": "tsc --noEmit && vite build --config vite.site.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:admin-build": "node ../scripts/verify-admin-build.mjs dist",
    "verify:portal-build": "node ../scripts/verify-portal-build.mjs dist-portal",
    "verify:portal:web": "node ../scripts/verify-portal-build.mjs dist-portal-web",
    "verify:site-build": "node ../scripts/verify-public-site-build.mjs dist-site"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^25.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
