{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gccwebos.com/governance/repair-policy-v1.schema.json",
  "title": "Repair Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "retryBudget",
    "autoRepairCategories",
    "escalationInvariants"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "retryBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C"],
      "properties": {
        "A": { "const": 0 },
        "B": { "type": "integer", "minimum": 0, "maximum": 1 },
        "C": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "autoRepairCategories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ci_configuration",
          "docs_metadata",
          "execution_transport",
          "test_fixture",
          "transport_format"
        ]
      }
    },
    "escalationInvariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "contract_change" } },
        { "contains": { "const": "credential_boundary" } },
        { "contains": { "const": "production_boundary" } },
        { "contains": { "const": "scope_drift" } },
        { "contains": { "const": "security_boundary" } },
        { "contains": { "const": "sensitive_output" } }
      ],
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    }
  }
}
