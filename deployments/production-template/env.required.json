{
  "schema": "gccgw.requiredEnvironment.v1",
  "metadata": {
    "name": "production-required-env",
    "secretsInGit": false
  },
  "runtime": [
    {
      "name": "NODE_ENV",
      "required": true,
      "secret": false,
      "example": "production"
    },
    {
      "name": "CONSOLE_TOKEN",
      "required": true,
      "secret": true,
      "storage": "protected-host-env"
    },
    {
      "name": "SS_PASSWORD",
      "required": true,
      "secret": true,
      "storage": "protected-host-env"
    },
    {
      "name": "SUBSCRIPTION_DB_PATH",
      "required": true,
      "secret": false,
      "example": "/opt/proxy-gateway-minimal/data/subscriptions.sqlite"
    },
    {
      "name": "SUBSCRIPTION_CONTROL_DB_PATH",
      "required": true,
      "secret": false,
      "example": "/opt/proxy-gateway-minimal/data/subscription-control.sqlite"
    },
    {
      "name": "PUBLIC_SUBSCRIPTION_BASE_URL",
      "required": true,
      "secret": false,
      "example": "https://control.example.invalid"
    }
  ],
  "optionalIntegrations": [
    {
      "name": "PAYMENT_PROVIDER",
      "required": false,
      "secret": false,
      "notes": "Reserved for later package purchase confirmation."
    },
    {
      "name": "PAYMENT_WEBHOOK_SECRET",
      "required": false,
      "secret": true,
      "storage": "protected-host-env"
    },
    {
      "name": "CHANNEL_LAB_B_TUIC_UUID",
      "required": false,
      "secret": true,
      "storage": "protected-host-env"
    },
    {
      "name": "CHANNEL_LAB_B_TUIC_PASSWORD",
      "required": false,
      "secret": true,
      "storage": "protected-host-env"
    }
  ],
  "forbidden": [
    "Do not commit concrete values for secret variables.",
    "Do not paste raw environment files into docs, PRs, chat, or logs.",
    "Do not store customer data or subscription URLs in this package."
  ]
}
