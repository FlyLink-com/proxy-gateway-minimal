# Payment provider adapter template.
# Copy to an operator-only environment file outside Git before using real values.
# Do not commit real provider tokens, AK/SK, private keys, webhook secrets, or customer data.

# Supported source vocabulary: paypal, worldfirst, stripe, paddle,
# lemonsqueezy, alipay, wechatpay, manual, mock.
# Niuniu Pay is retired and must not be used for new integrations.
PAYMENT_PROVIDER=mock
PAYMENT_MODE=sandbox
PAYMENT_PUBLIC_BASE_URL=https://pay.example.com
PAYMENT_RETURN_URL=https://pay.example.com/return
PAYMENT_CANCEL_URL=https://pay.example.com/cancel

# Generic provider credentials. Use provider-specific names only in private runtime env.
# PayPal maps API key/secret to REST client id/client secret.
PAYMENT_PROVIDER_API_KEY=replace_with_provider_api_key_or_client_id
PAYMENT_PROVIDER_API_SECRET=replace_with_provider_api_secret_or_client_secret
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace_with_provider_webhook_secret

# WorldFirst-style integrations use a client id and operator-managed RSA keys.
PAYMENT_PROVIDER_CLIENT_ID=replace_with_provider_client_id

# Optional fields for providers that require merchant/app/certificate metadata.
PAYMENT_PROVIDER_MERCHANT_ID=replace_with_provider_merchant_id
PAYMENT_PROVIDER_APP_ID=replace_with_provider_app_id
PAYMENT_PROVIDER_CERT_SERIAL=replace_with_provider_certificate_serial
PAYMENT_PROVIDER_PRIVATE_KEY_PATH=/operator-only/path/payment-provider-private-key.pem
PAYMENT_PROVIDER_PLATFORM_PUBLIC_KEY_PATH=/operator-only/path/provider-platform-public-key.pem
