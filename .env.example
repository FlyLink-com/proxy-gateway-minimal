# Runtime environment closure.
# Copy to .env on the target host and fill values there only.
# Do not commit real tokens, passwords, private URLs, customer data, or node credentials.

NODE_ENV=production
CONSOLE_PORT=3456
CONSOLE_TOKEN=__SET_ON_HOST__
SS_PASSWORD=__SET_ON_HOST__

SUBSCRIPTION_DB_PATH=/opt/proxy-gateway-minimal/.proxy-gateway/subscriptions.sqlite
SUBSCRIPTION_CONTROL_DB_PATH=/opt/proxy-gateway-minimal/.proxy-gateway/subscription-control.sqlite
# Optional Wallet Core runtime. Keep disabled; schema apply alone does not authorize runtime enablement.
COINS_WALLET_ENABLED=false
COINS_COMMERCE_ENABLED=false
# Keep canary by default. Production all-account activation requires an
# approved Gate with all_active and an empty canary hash list.
COINS_COMMERCE_AUDIENCE=canary
PLATFORM_COIN_RECHARGE_ENABLED=false
PLATFORM_PAYPAL_SANDBOX_ENABLED=false
PLATFORM_COIN_RECHARGE_USD_OFFERS_JSON=[]
PLATFORM_PAYPAL_SANDBOX_CLIENT_ID=
PLATFORM_PAYPAL_SANDBOX_CLIENT_SECRET=
PLATFORM_PAYPAL_SANDBOX_WEBHOOK_ID=
PLATFORM_PAYPAL_SANDBOX_MERCHANT_SCOPE_DIGEST=
PLATFORM_PAYPAL_CALLBACK_URL=
PLATFORM_PAYPAL_RETURN_URL=
COINS_COMMERCE_CANARY_ACCOUNT_HASHES=
COINS_COMMERCE_CANCEL_WINDOW_MS=3000
HANDOFF_DIR=/opt/proxy-gateway-minimal/handoff
PUBLIC_SUBSCRIPTION_BASE_URL=https://control.example.invalid

ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1
TRUSTED_PROXY_CIDRS=
EDGE_DATA_PLANE_AGENT_ALLOWED_CIDRS=127.0.0.1/32,::1

SUB_RATE_LIMIT_WINDOW_MS=60000
SUB_RATE_LIMIT_MAX=30
SUB_CREDENTIAL_RATE_LIMIT_WINDOW_MS=60000
SUB_CREDENTIAL_RATE_LIMIT_MAX=30
USER_PORTAL_REFRESH_COOLDOWN_MS=300000
SUBSCRIPTION_TEMP_LINK_TTL_MINUTES=1440

# Optional payment integration placeholders. Leave blank until a provider is approved.
PAYMENT_PROVIDER=
PAYMENT_MODE=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=
PAYMENT_PUBLIC_BASE_URL=

# Optional AppsFlyer attribution placeholders. Disabled by default.
# dry_run may build redacted Web SDK/S2S plans; live dispatch requires a separate
# production approval gate and approved secret placement.
APPSFLYER_ATTRIBUTION_MODE=disabled
APPSFLYER_DEV_KEY=
APPSFLYER_WEB_DEV_KEY=
APPSFLYER_APP_ID=

# Optional developer tooling. Leave blank unless generating AI handoff briefs locally.
# ANTHROPIC_API_KEY=

# Optional channel/canary placeholders. Leave blank unless a channel runbook approves them.
CHANNEL_LAB_B_TUIC_HOST=
CHANNEL_LAB_B_TUIC_UUID=
CHANNEL_LAB_B_TUIC_PASSWORD=
CHANNEL_LAB_B_TUIC_CERT=

# Optional explicit-restart edge lifecycle wiring. Fill on the target host only
# after an approved production gate; paths and secrets below are placeholders.
USER_PORTAL_EDGE_LIFECYCLE_ENABLED=
USER_PORTAL_TOTP_SECRET_KEY=
USER_PORTAL_EDGE_CHANNEL_REFS=channel-vultr-a-vless-reality-tcp,channel-vultr-a-hy2,channel-vultr-a-tuic,channel-sgp-a-vless-reality-tcp,channel-sgp-a-hy2,channel-sgp-a-tuic
EDGE_CREDENTIAL_CHANNEL_REFS=channel-vultr-a-vless-reality-tcp,channel-vultr-a-hy2,channel-vultr-a-tuic,channel-sgp-a-vless-reality-tcp,channel-sgp-a-hy2,channel-sgp-a-tuic
USER_PORTAL_AUTO_ISSUANCE_ENABLED=
USER_PORTAL_AUTO_ISSUANCE_NODE_ID=channel-vultr-a-vless-reality-tcp
USER_PORTAL_AUTO_ISSUANCE_CHANNEL_REFS=channel-vultr-a-vless-reality-tcp,channel-vultr-a-hy2,channel-vultr-a-tuic,channel-sgp-a-vless-reality-tcp,channel-sgp-a-hy2,channel-sgp-a-tuic
EDGE_CREDENTIAL_MATERIAL_PATH=
EDGE_CREDENTIAL_LIFECYCLE_EXECUTE_PRODUCTION_MUTATION=
VULTR_VLESS_REALITY_HOST=
VULTR_VLESS_REALITY_UUID=
VULTR_VLESS_REALITY_SNI=
VULTR_VLESS_REALITY_PUBLIC_KEY=
VULTR_VLESS_REALITY_SHORT_ID=
VULTR_HY2_HOST=
VULTR_HY2_PASSWORD=
VULTR_HY2_SNI=
VULTR_TUIC_HOST=
VULTR_TUIC_UUID=
VULTR_TUIC_PASSWORD=
VULTR_TUIC_SNI=
SGP_VLESS_REALITY_HOST=
SGP_VLESS_REALITY_UUID=
SGP_VLESS_REALITY_SNI=
SGP_VLESS_REALITY_PUBLIC_KEY=
SGP_VLESS_REALITY_SHORT_ID=
SGP_HY2_HOST=
SGP_HY2_PASSWORD=
SGP_HY2_SNI=
SGP_TUIC_HOST=
SGP_TUIC_UUID=
SGP_TUIC_PASSWORD=
SGP_TUIC_SNI=
EDGE_HYSTERIA2_ACTIVE_CONFIG_PATH=
EDGE_HYSTERIA2_CANDIDATE_CONFIG_PATH=
EDGE_HYSTERIA2_BACKUP_DIR=
EDGE_HYSTERIA2_BINARY=hysteria
EDGE_HYSTERIA2_LISTEN=:10443
EDGE_HYSTERIA2_CERTIFICATE_PATH=
EDGE_HYSTERIA2_PRIVATE_KEY_PATH=
EDGE_HYSTERIA2_TRAFFIC_STATS_LISTEN=127.0.0.1:26080
EDGE_HYSTERIA2_TRAFFIC_STATS_SECRET=
EDGE_MIHOMO_USAGE_CONTROLLER_URL=
EDGE_MIHOMO_USAGE_METRICS_PATH=
EDGE_MIHOMO_USAGE_CONTROLLER_SECRET=
EDGE_MIHOMO_USAGE_CREDENTIAL_MAP_PATH=
EDGE_MIHOMO_USAGE_CREDENTIAL_MAP_JSON=
EDGE_MIHOMO_USAGE_CHANNEL_REFS=
EDGE_MIHOMO_USAGE_SOURCES_JSON=
EDGE_MIHOMO_RUNTIME_CONTROLLER_URL=
EDGE_MIHOMO_RUNTIME_CONTROLLER_SECRET=
EDGE_MIHOMO_RUNTIME_CONTROLLER_SECRET_FILE=
EDGE_XRAY_STATS_SERVER=
EDGE_XRAY_USAGE_CHANNEL_REFS=
EDGE_XRAY_USAGE_SOURCES_JSON=
EDGE_XRAY_RUNTIME_STATS_SERVER=
EDGE_HYSTERIA2_SNIFF_ENABLED=true
EDGE_HYSTERIA2_SNIFF_REWRITE_DOMAIN=true
EDGE_HYSTERIA2_SNIFF_TCP_PORTS=80,443,8000-9000
EDGE_HYSTERIA2_SNIFF_UDP_PORTS=all
EDGE_HYSTERIA2_OUTBOUND_MODE=4
