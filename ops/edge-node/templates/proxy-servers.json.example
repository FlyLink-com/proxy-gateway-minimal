{
  "servers": [
    {
      "name": "prod-edge-c",
      "host": "edge-c.gccwebos.com",
      "port": 18388,
      "method": "aes-256-gcm",
      "password": "${SS_PASSWORD}",
      "type": "shadowsocks-libev",
      "note": "Provider-neutral recovery edge slot"
    }
  ],
  "pingHosts": ["edge-c.gccwebos.com"],
  "nginx": {
    "host": "sub.gccwebos.com",
    "ports": [80, 443, 18388]
  }
}
