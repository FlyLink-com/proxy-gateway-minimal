{"$id":"https://github.com/FlyLink-com/proxy-gateway-minimal/ops/node-provisioning/schemas/jp01-vultr-preflight-report.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Redacted report emitted by the JP01 Vultr API Preflight workflow. The report must never contain the API key, account contact details, balances, or the raw API response; additionalProperties is false so any such field fails validation.","properties":{"account_acls":{"items":{"type":"string"},"type":"array","uniqueItems":true},"checks":{"items":{"additionalProperties":false,"properties":{"id":{"enum":["secret_present","http_status_200","provisioning_acl_present"],"type":"string"},"status":{"enum":["pass","fail"],"type":"string"}},"required":["id","status"],"type":"object"},"maxItems":3,"minItems":3,"type":"array"},"commit_sha":{"pattern":"^[a-f0-9]{40}$","type":"string"},"endpoint":{"const":"GET https://api.vultr.com/v2/account","type":"string"},"environment":{"const":"jp01-c1-production","type":"string"},"http_status":{"maximum":599,"minimum":0,"type":"integer"},"ref":{"const":"refs/heads/master","type":"string"},"run_attempt":{"minimum":1,"type":"integer"},"run_id":{"pattern":"^[0-9]+$","type":"string"},"schema":{"const":"jp01-vultr-preflight-report/v1","type":"string"},"secret_present":{"type":"boolean"},"side_effects":{"additionalProperties":false,"properties":{"api_writes":{"const":"none","type":"string"},"resources_created":{"const":"none","type":"string"}},"required":["api_writes","resources_created"],"type":"object"},"tested_at":{"format":"date-time","type":"string"},"verdict":{"enum":["pass","fail"],"type":"string"},"workflow":{"minLength":1,"type":"string"}},"required":["schema","workflow","run_id","run_attempt","commit_sha","ref","environment","tested_at","endpoint","secret_present","http_status","account_acls","checks","verdict","side_effects"],"title":"JP-01 Vultr API Preflight Report","type":"object"}