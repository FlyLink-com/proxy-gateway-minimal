{"$id":"https://github.com/FlyLink-com/proxy-gateway-minimal/ops/node-provisioning/schemas/dual-side-gate.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Dual-side gate report: the cross-validation of one BWH integration plan and one node runtime plan of the same generation, per section 7 of the Post-Install Dual-Side Integration design v0.1. The verdict is pass only when every check passes; any fail or not_evaluated check blocks service activation (DUAL_SIDE_GATE_BLOCKED). Carries digests and check outcomes only — no configuration bodies, no secrets.","properties":{"bwhPlanDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"},"checks":{"items":{"additionalProperties":false,"properties":{"detail":{"maxLength":300,"type":"string"},"id":{"enum":["node_ref_match","provider_ref_match","region_ref_match","role_ref_match","channel_refs_match","image_manifest_ref_match","profile_digest_match","generation_match","wireguard_key_cross_match","allowed_ips_within_plan","no_default_route","agent_binding_match","agent_private_path_only","protocol_config_tests","stats_loopback_only","no_unreplaced_placeholders","file_permissions","secret_hygiene_scan","material_digests_match"],"type":"string"},"status":{"enum":["pass","fail","not_evaluated"],"type":"string"}},"required":["id","status"],"type":"object"},"minItems":1,"type":"array"},"evaluatedAt":{"format":"date-time","type":"string"},"gateRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"generation":{"minimum":1,"type":"integer"},"nodePlanDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"},"nodeRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"profileDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"},"schema":{"const":"dual-side-gate/v1","type":"string"},"verdict":{"enum":["pass","blocked"],"type":"string"}},"required":["schema","gateRef","evaluatedAt","nodeRef","generation","profileDigest","bwhPlanDigest","nodePlanDigest","checks","verdict"],"title":"Dual-Side Gate Report","type":"object"}