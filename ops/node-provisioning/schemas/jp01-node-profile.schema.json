{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlyLink-com/proxy-gateway-minimal/ops/node-provisioning/schemas/jp01-node-profile.schema.json",
  "title": "JP-01 D2 Node Profile",
  "description": "Source-only canonical profile projection for the two D1-compatible D2 renderers. It contains safe references, fingerprints and digests only; no credentials, private keys, protocol material or runtime configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nodeRef",
    "providerRef",
    "regionRef",
    "roleRef",
    "generation",
    "nodePlanRef",
    "bwhPlanRef",
    "imageManifestRef",
    "releaseRef",
    "firstBootPacketRef",
    "wireguardPlanRef",
    "hostname",
    "agentAuthFingerprint",
    "agentEndpointRef",
    "channels"
  ],
  "properties": {
    "schema": {
      "const": "jp01-d2-node-profile/v1",
      "type": "string"
    },
    "nodeRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "providerRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "regionRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "roleRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "generation": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "nodePlanRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "bwhPlanRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "imageManifestRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "releaseRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "firstBootPacketRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "wireguardPlanRef": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "type": "string"
    },
    "hostname": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "agentAuthFingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "agentEndpointRef": {
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "type": "string"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channelRef",
          "runtimeAdapter",
          "desiredStateRef",
          "materialRef",
          "materialDigest",
          "endpointRef",
          "unitName",
          "configDigest",
          "statsListen"
        ],
        "properties": {
          "channelRef": {
            "pattern": "^[A-Za-z0-9._:-]{1,160}$",
            "type": "string"
          },
          "runtimeAdapter": {
            "enum": [
              "xray",
              "hysteria2",
              "mihomo"
            ],
            "type": "string"
          },
          "desiredStateRef": {
            "pattern": "^[A-Za-z0-9._:-]{1,160}$",
            "type": "string"
          },
          "materialRef": {
            "pattern": "^[A-Za-z0-9._:-]{1,160}$",
            "type": "string"
          },
          "materialDigest": {
            "pattern": "^[A-Za-z0-9._:+/-]{6,256}$",
            "type": "string"
          },
          "endpointRef": {
            "pattern": "^[A-Za-z0-9._:-]{1,160}$",
            "type": "string"
          },
          "unitName": {
            "pattern": "^[A-Za-z0-9@._-]+\\.service$",
            "type": "string"
          },
          "configDigest": {
            "pattern": "^[A-Za-z0-9._:+/-]{6,256}$",
            "type": "string"
          },
          "statsListen": {
            "enum": [
              "127.0.0.1",
              "::1"
            ],
            "type": "string"
          }
        }
      }
    }
  }
}
