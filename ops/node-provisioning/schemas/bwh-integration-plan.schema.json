{"$id":"https://github.com/FlyLink-com/proxy-gateway-minimal/ops/node-provisioning/schemas/bwh-integration-plan.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Control-plane (BWH) side of the dual-side integration contract, rendered from a Node Profile. Contains only safe references, generations, digests, and public-key fingerprints — never protocol passwords, UUIDs, private keys, tokens, full runtime configuration, or customer data (the key vocabulary follows the forbidden-key set of server/services/edge/data-plane-agent-protocol.mjs). The identity anchors wireguardPublicKeyFingerprint and agentAuthFingerprint are the node's anchors as established by the identity exchange (see POSTINSTALL_IDENTITY_EXCHANGE.md) and match the E1 registration binding fields in server/services/edge/node-registration-ingestion.mjs.","properties":{"agent":{"additionalProperties":false,"properties":{"agentAuthFingerprint":{"description":"SHA-256 fingerprint of the node agent token; the token itself never appears.","pattern":"^[a-f0-9]{64}$","type":"string"},"endpointRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"}},"required":["agentAuthFingerprint","endpointRef"],"type":"object"},"channelRefs":{"items":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"minItems":1,"type":"array","uniqueItems":true},"channels":{"items":{"additionalProperties":false,"properties":{"channelRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"desiredStateRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"endpointRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"materialDigest":{"pattern":"^[A-Za-z0-9._:+/-]{6,256}$","type":"string"},"materialRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"runtimeAdapter":{"enum":["xray","hysteria2","mihomo"],"type":"string"}},"required":["channelRef","runtimeAdapter","desiredStateRef","materialRef","materialDigest","endpointRef"],"type":"object"},"minItems":1,"type":"array"},"digest":{"pattern":"^[a-f0-9]{64}$","type":"string"},"firstBootPacketRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"generation":{"minimum":1,"type":"integer"},"imageManifestRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"lifecycle":{"const":"private-validation","type":"string"},"nodeRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"planRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"pool":{"const":"private","type":"string"},"profileDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"},"providerRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"regionRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"releaseRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"roleRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"schema":{"const":"bwh-integration-plan/v1","type":"string"},"wireguard":{"additionalProperties":false,"properties":{"allowedIps":{"items":{"pattern":"^[0-9a-fA-F:./]+$","type":"string"},"minItems":1,"type":"array","uniqueItems":true},"bwhPeerPublicKeyFingerprint":{"description":"SHA-256 fingerprint of the BWH WireGuard public key for this peer relation; BWH's existing key is never regenerated for a new node.","pattern":"^[a-f0-9]{64}$","type":"string"},"nodePeerPublicKeyFingerprint":{"description":"SHA-256 fingerprint of the node WireGuard public key; identical to the registration binding anchor wireguardPublicKeyFingerprint.","pattern":"^[a-f0-9]{64}$","type":"string"},"planRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"}},"required":["planRef","bwhPeerPublicKeyFingerprint","nodePeerPublicKeyFingerprint","allowedIps"],"type":"object"}},"required":["schema","planRef","generation","nodeRef","providerRef","regionRef","roleRef","channelRefs","imageManifestRef","releaseRef","firstBootPacketRef","profileDigest","lifecycle","pool","channels","wireguard","agent","digest"],"title":"BWH Integration Plan (dual-side contract, BWH side)","type":"object"}