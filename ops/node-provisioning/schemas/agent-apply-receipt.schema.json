{"$id":"https://github.com/FlyLink-com/proxy-gateway-minimal/ops/node-provisioning/schemas/agent-apply-receipt.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"The agent's raw per-channel apply receipt, mirroring validateDataPlaneApplyReceipt in server/services/edge/data-plane-agent-protocol.mjs field for field: single channelRef, boolean configTest / serviceActive / listenerPresent, credentialCount, materialDigests (digest strings or {channelRef, edgeCredentialRef, digest} entries), redacted always true. This schema adds nothing to the protocol; the post-install summary that aggregates the three channels lives in postinstall-receipt.schema.json under its own message type.","properties":{"appliedAt":{"format":"date-time","type":"string"},"backupRef":{"pattern":"^[A-Za-z0-9._:-]{1,128}$","type":"string"},"channelRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"configTest":{"type":"boolean"},"credentialCount":{"minimum":0,"type":"integer"},"desiredStateRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"generation":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"listenerPresent":{"type":"boolean"},"materialDigests":{"items":{"anyOf":[{"pattern":"^[A-Za-z0-9._:+/-]{6,256}$","type":"string"},{"additionalProperties":false,"properties":{"channelRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"digest":{"pattern":"^[A-Za-z0-9._:+/-]{6,256}$","type":"string"},"edgeCredentialRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"}},"required":["channelRef","edgeCredentialRef","digest"],"type":"object"}]},"type":"array"},"nodeRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"reasonCode":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"redacted":{"const":true,"type":"boolean"},"rollbackRef":{"pattern":"^[A-Za-z0-9._:-]{1,128}$","type":"string"},"scopedTombstone":{"additionalProperties":false,"properties":{"credentialDigests":{"items":{"pattern":"^[A-Za-z0-9._:+/-]{6,256}$","type":"string"},"minItems":1,"type":"array"},"sourceDesiredStateRef":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"},"sourceGeneration":{"pattern":"^[A-Za-z0-9._:-]{1,160}$","type":"string"}},"required":["credentialDigests"],"type":"object"},"serviceActive":{"type":"boolean"},"status":{"enum":["applied","failed","unchanged","stale","rejected"],"type":"string"},"type":{"const":"gccgw_data_plane_apply_receipt","type":"string"}},"required":["type","nodeRef","generation","channelRef","status","configTest","serviceActive","listenerPresent","credentialCount","appliedAt","materialDigests","redacted"],"title":"Agent Apply Receipt (existing protocol, per channel)","type":"object"}